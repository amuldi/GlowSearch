NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.onrender.com

# --- Admin review proxy (milestone 6) ---
# Server-only. Never prefix these with NEXT_PUBLIC_ — that would inline them
# into the browser bundle. Only read by frontend/middleware.ts and
# frontend/src/server/adminReviewClient.ts.

# Must match the backend's GLOWSEARCH_ADMIN_REVIEW_TOKEN exactly (same value,
# copied into this project's env separately). Used server-side only, to call
# the FastAPI /index/matches/* API on the browser's behalf.
GLOWSEARCH_ADMIN_REVIEW_TOKEN=

# Temporary HTTP Basic Auth gate for /admin/* (middleware.ts) — a single
# shared credential, unrelated to GLOWSEARCH_ADMIN_REVIEW_TOKEN above. Not a
# real login system; replace with real auth in a future milestone.
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=
